# Copy to server/.env (or set in the PM2 ecosystem). All optional.
PORT=3030
# Where db.json, media, covers and images are stored (relative to server/).
DATA_DIR=data
# Signing key for login tokens. If unset, a random one is generated once and kept in DATA_DIR/secret.key.
JWT_SECRET=
# Free key from https://devportal.jamendo.com — enables Jamendo search + downloads.
JAMENDO_CLIENT_ID=
# yt-dlp binary for "other site" download links (default: /home/dev/bin/yt-dlp if it exists).
YTDLP_PATH=
